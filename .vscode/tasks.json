{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-create_ansewer_json",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "create_answer_json.cpp",
                "base.cpp",
                "-o",
                "./bin/create_answer_json.exe",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "rm-create_ansewer_json",
            "type": "shell",
            "command": "rm",
            "args": [
                "./bin/create_answer_json.exe",
            ],
            "group": "build",
        },
        {
            "label": "build-input_problem",
            "type": "shell",
            "command": "g++",
            "args": [
                "input_problem.cpp",
                "-o",
                "./bin/input_problem.exe",
                "-g",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
         {
            "label": "rm-input_problem",
            "type": "shell",
            "command": "rm",
            "args": [
                "./bin/input_problem.exe",
            ],
            "group": "build",
        },
        {
            "label": "build-solver",
            "type": "shell",
            "command":"g++",
            "args": [
                "solver.cpp",
                "-o",
                "-g",
                "./bin/solver.exe",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher":[
                "$gcc"
            ]
        },
        {
           "label": "rm-solver",
            "type": "shell",
            "command": "rm",
            "args": [
                "./bin/solver.exe",
            ],
            "group": "build",
        },
        {
            "label": "build-main",
            "type": "shell",
            "command": "g++",
            "args": [
                "main.cpp",
                "evalution.cpp",
                "base.cpp",
                "solver.cpp",
                "-o",
                "./bin/main.exe",
                "-O3",
                "-g",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
         {
            "label": "rm-main",
            "type": "shell",
            "command": "rm",
            "args": [
                "./bin/main.exe",
            ],
            "group": "build",
        },
         {
            "label": "build-print_analysis",
            "type": "shell",
            "command": "g++",
            "args": [
                "print_analysis.cpp",
                "base.cpp",
                "evalution.cpp",
                "-o",
                "./bin/print_analysis.exe",
                "-g",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "rm-print_analysis",
            "type": "shell",
            "command": "rm",
            "args": [
                "./bin/print_analysis.exe"
            ],
            "group": "build",
        },
        
    ]
}